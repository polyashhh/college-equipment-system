generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model audit_logs {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  action      String    @db.VarChar(255)
  entity_type String    @db.VarChar(255)
  entity_id   Int?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model equipment {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @db.VarChar(255)
  inventory_number       String                   @unique @db.VarChar(255)
  description            String?
  status                 String?                  @default("available") @db.VarChar(255)
  category_id            Int?
  room_id                Int?
  image_path             String?                  @db.VarChar(255)
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  updated_at             DateTime?                @default(now()) @db.Timestamp(6)
  equipment_categories   equipment_categories?    @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  rooms                  rooms?                   @relation(fields: [room_id], references: [id], onUpdate: NoAction)
  equipment_transactions equipment_transactions[]
  request_items          request_items[]
}

model equipment_categories {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(255)
  description String?
  equipment   equipment[]
}

model equipment_transactions {
  id                                               Int        @id @default(autoincrement())
  equipment_id                                     Int?
  user_id                                          Int?
  performed_by                                     Int?
  transaction_type                                 String     @db.VarChar(255)
  from_room_id                                     Int?
  to_room_id                                       Int?
  issued_at                                        DateTime?  @default(now()) @db.Timestamp(6)
  returned_at                                      DateTime?  @db.Timestamp(6)
  created_at                                       DateTime?  @default(now()) @db.Timestamp(6)
  equipment                                        equipment? @relation(fields: [equipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rooms_equipment_transactions_from_room_idTorooms rooms?     @relation("equipment_transactions_from_room_idTorooms", fields: [from_room_id], references: [id], onUpdate: NoAction)
  users_equipment_transactions_performed_byTousers users?     @relation("equipment_transactions_performed_byTousers", fields: [performed_by], references: [id], onUpdate: NoAction)
  rooms_equipment_transactions_to_room_idTorooms   rooms?     @relation("equipment_transactions_to_room_idTorooms", fields: [to_room_id], references: [id], onUpdate: NoAction)
  users_equipment_transactions_user_idTousers      users?     @relation("equipment_transactions_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)
}

model request_items {
  id           Int        @id @default(autoincrement())
  request_id   Int?
  equipment_id Int?
  equipment    equipment? @relation(fields: [equipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requests     requests?  @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model requests {
  id               Int             @id @default(autoincrement())
  user_id          Int?
  status           String?         @default("pending") @db.VarChar(255)
  comment          String?
  rejection_reason String?
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  updated_at       DateTime?       @default(now()) @db.Timestamp(6)
  request_items    request_items[]
  users            users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model roles {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(255)
  users users[]
}

model rooms {
  id                                                                Int                      @id @default(autoincrement())
  number                                                            String                   @db.VarChar(255)
  building                                                          String?                  @db.VarChar(255)
  description                                                       String?
  equipment                                                         equipment[]
  equipment_transactions_equipment_transactions_from_room_idTorooms equipment_transactions[] @relation("equipment_transactions_from_room_idTorooms")
  equipment_transactions_equipment_transactions_to_room_idTorooms   equipment_transactions[] @relation("equipment_transactions_to_room_idTorooms")
}

model users {
  id                                                                Int                      @id @default(autoincrement())
  name                                                              String                   @db.VarChar(255)
  email                                                             String                   @unique @db.VarChar(255)
  password_hash                                                     String                   @db.VarChar(255)
  role_id                                                           Int?
  is_blocked                                                        Boolean?                 @default(false)
  created_at                                                        DateTime?                @default(now()) @db.Timestamp(6)
  updated_at                                                        DateTime?                @default(now()) @db.Timestamp(6)
  audit_logs                                                        audit_logs[]
  equipment_transactions_equipment_transactions_performed_byTousers equipment_transactions[] @relation("equipment_transactions_performed_byTousers")
  equipment_transactions_equipment_transactions_user_idTousers      equipment_transactions[] @relation("equipment_transactions_user_idTousers")
  requests                                                          requests[]
  roles                                                             roles?                   @relation(fields: [role_id], references: [id], onUpdate: NoAction)
}
